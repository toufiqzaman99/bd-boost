# Copy this file to .env and replace the password.
# Use a long, random password (minimum 12 characters).
PORT=3000
ADMIN_PASSWORD=replace-with-a-long-random-password
SESSION_TTL_HOURS=12
CUSTOMER_SESSION_TTL_DAYS=30

# Optional: path to a persistent directory for order storage.
# DATA_DIR=/var/data/thundermax

# Optional: set to "true" only when running behind a trusted reverse proxy.
# TRUST_PROXY=true

# Optional: bind address. Defaults to 0.0.0.0.
# HOST=0.0.0.0
